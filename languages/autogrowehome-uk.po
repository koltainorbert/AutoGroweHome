msgstr "перевірено"

#: includes/Frontend/Strings.php
msgid "Ellenőrzőlista"
msgstr "Контрольний список"

#: includes/Frontend/Strings.php
msgid "– válassz –"
msgstr "– виберіть –"

#: includes/Frontend/Strings.php
