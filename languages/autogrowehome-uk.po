msgstr "Збільшити"

#: includes/Frontend/Frontend.php:119
#: includes/Frontend/Strings.php:50
msgid "A háztervező nem tölthető be. Kérjük, próbáld újra később."
msgstr "Не вдалося завантажити проєктувальник будинків. Будь ласка, спробуйте пізніше."

#: includes/Frontend/Strings.php:51
msgid "Hálózati hiba. Kérjük, próbáld újra."
msgstr "Помилка мережі. Будь ласка, спробуйте ще раз."

#: includes/Frontend/Strings.php:52
msgid "A generálás nem sikerült. A keretet nem vontuk le, ha nem keletkezett költség."
msgstr "Генерація не вдалася. Квоту не списано, якщо не виникло витрат."

#: includes/Frontend/Strings.php:53
msgid "Ehhez a nézethez még nincs kép."
msgstr "Для цього ракурсу зображення ще немає."

#: includes/Frontend/Strings.php:54
msgid "Galéria készül"
msgstr "Створюється галерея"

#: includes/Frontend/Strings.php:55
msgid "Elindítottuk a kiválasztott ház teljes galériájának elkészítését."
msgstr "Запущено створення повної галереї вибраного будинку."

#: includes/Frontend/Strings.php:56
