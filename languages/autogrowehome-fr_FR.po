#: includes/Frontend/Frontend.php:118
#: includes/Frontend/Frontend.php:132
#: includes/Frontend/Strings.php:17
msgid "Tervezd meg álmaid otthonát"
msgstr "Concevez la maison de vos rêves"

#: includes/Frontend/Help.php:18
msgid "Üdv a háztervezőben!"
msgstr "Bienvenue dans le concepteur de maisons !"

#: includes/Frontend/Help.php:18
msgid "Néhány perc alatt három különböző házkoncepciót kapsz fotórealisztikus látványtervekkel és tervvázlatokkal."
msgstr "En quelques minutes, vous obtenez trois concepts de maison différents avec des visuels photoréalistes et des esquisses de plan."

#: includes/Frontend/Help.php:19
msgid "1. Add meg az alapokat"
msgstr "1. Renseignez l'essentiel"

#: includes/Frontend/Help.php:19
msgid "Bal oldalt kategóriánként állíthatod a házat. Egyszerű módban csak a legfontosabbakat látod, a Részletes mód mindent megmutat."
msgstr "À gauche, vous configurez la maison par catégories. Le mode Simple n'affiche que l'essentiel, le mode Détaillé montre tout."

#: includes/Frontend/Help.php:20
msgid "2. Ellenőrizd az összegzést"
msgstr "2. Vérifiez le récapitulatif"

#: includes/Frontend/Help.php:20
msgid "Jobb oldalt élőben látod a főbb adatokat és az esetleges ellentmondásokat. Generálás csak akkor indul, ha te kéred."
msgstr "À droite, vous voyez en direct les principales données et les éventuelles incohérences. La génération ne démarre qu'à votre demande."

#: includes/Frontend/Help.php:21
msgid "3. Generálj három koncepciót"
msgstr "3. Générez trois concepts"

#: includes/Frontend/Help.php:21
msgid "Egy generálás három különálló házváltozatot készít. Naponta korlátozott számú generálás indítható."
msgstr "Chaque génération crée trois variantes de maison distinctes. Le nombre de générations par jour est limité."

#: includes/Frontend/Help.php:22
msgid "4. Válaszd ki a kedvenced"
msgstr "4. Choisissez votre préféré"

#: includes/Frontend/Help.php:22
msgid "A kiválasztott házhoz elkészül a teljes galéria; a fő látványképet letöltheted, a projektet elmentheted."
msgstr "La galerie complète est créée pour la maison sélectionnée ; vous pouvez télécharger le visuel principal et enregistrer le projet."

#: includes/Frontend/Help.php:23
msgid "5. Kérj ajánlatot"
msgstr "5. Demandez un devis"

#: includes/Frontend/Help.php:23
msgid "Ha szeretnéd, a hozzájárulásod után a teljes tervcsomagot továbbítjuk a kivitelezőnek."
msgstr "Si vous le souhaitez, et avec votre consentement, nous transmettons le dossier complet à l'entrepreneur."

#: includes/Frontend/Help.php:28
msgid "Általános"
msgstr "Général"

#: includes/Frontend/Help.php:29
#: includes/Frontend/Strings.php:251
msgid "Tervezés"
msgstr "Conception"

#: includes/Frontend/Help.php:30
msgid "Adatvédelem"
msgstr "Protection des données"

#: includes/Frontend/Help.php:33
msgid "Mi ez a háztervező?"
msgstr "Qu'est-ce que ce concepteur de maisons ?"

#: includes/Frontend/Help.php:33
msgid "Egy AI-alapú eszköz, amely a megadott paraméterekből három különböző házkoncepciót készít látványtervekkel és koncepcionális tervvázlatokkal."
msgstr "Un outil basé sur l'IA qui crée, à partir des paramètres indiqués, trois concepts de maison différents avec des visuels et des esquisses de plan conceptuelles."

#: includes/Frontend/Help.php:34
msgid "Kell hozzá építészeti tudás?"
msgstr "Faut-il des connaissances en architecture ?"

#: includes/Frontend/Help.php:34
msgid "Nem. Az Egyszerű mód csak a legfontosabb kérdéseket teszi fel, a többit a rendszer javasolja."
msgstr "Non. Le mode Simple ne pose que les questions essentielles, le système propose le reste."

#: includes/Frontend/Help.php:35
msgid "Engedélyezési tervnek használhatom a vázlatokat?"
msgstr "Puis-je utiliser les esquisses pour une demande de permis de construire ?"

#: includes/Frontend/Help.php:35
msgid "Nem. A tervvázlatok strukturált adatokból generált koncepciótervek; engedélyezéshez és kivitelezéshez szakági tervező szükséges."
msgstr "Non. Les esquisses de plan sont des plans conceptuels générés à partir de données structurées ; pour le permis de construire et la réalisation, un concepteur qualifié est nécessaire."

#: includes/Frontend/Help.php:36
msgid "Miért korlátozott a napi generálások száma?"
msgstr "Pourquoi le nombre de générations par jour est-il limité ?"

#: includes/Frontend/Help.php:36
msgid "A képgenerálás valódi költséggel jár. Egy generálás három koncepciót jelent, és egy napi keretbe számít."
msgstr "La génération d'images a un coût réel. Une génération correspond à trois concepts et est décomptée du quota quotidien."

#: includes/Frontend/Help.php:37
msgid "Mennyi ideig tart a generálás?"
msgstr "Combien de temps dure la génération ?"

#: includes/Frontend/Help.php:37
msgid "Jellemzően néhány perc, de a külső szolgáltatók terhelésétől függ. Közben bezárhatod az ablakot; a mentett projektet később megnyithatod."
msgstr "En général quelques minutes, mais cela dépend de la charge des fournisseurs externes. Vous pouvez fermer la fenêtre entre-temps ; le projet enregistré pourra être rouvert plus tard."

#: includes/Frontend/Help.php:38
msgid "Ugyanaz a ház szerepel minden képen?"
msgstr "Est-ce la même maison sur toutes les images ?"

#: includes/Frontend/Help.php:38
msgid "A rendszer rögzített épületleírással és referenciaképpel dolgozik az egységesség érdekében, de az AI-képeken kisebb eltérések előfordulhatnak."
msgstr "Le système travaille avec une description fixe du bâtiment et une image de référence pour garantir la cohérence, mais de légers écarts peuvent apparaître sur les images IA."

#: includes/Frontend/Help.php:39
msgid "Milyen adatokat tárolunk?"
msgstr "Quelles données conservons-nous ?"

#: includes/Frontend/Help.php:39
msgid "A ház paramétereit és a generált képeket. Személyes adatot csak ajánlatkéréskor kérünk, a kifejezett hozzájárulásoddal. Az IP-címet csak kódolt (hash) formában, a napi keret ellenőrzéséhez használjuk."
msgstr "Les paramètres de la maison et les images générées. Nous ne demandons des données personnelles que lors d'une demande de devis, avec votre consentement explicite. L'adresse IP n'est utilisée que sous forme chiffrée (hash), pour contrôler le quota quotidien."

#: includes/Frontend/Help.php:40
msgid "Átadjuk-e az adataimat AI-szolgáltatónak?"
msgstr "Mes données sont-elles transmises à un fournisseur d'IA ?"

#: includes/Frontend/Help.php:40
msgid "A ház paraméterei és a szabad szöveges leírás a képgenerálás és az értelmezés céljából a beállított AI-szolgáltatókhoz kerülnek; személyes elérhetőségeid nem."
msgstr "Les paramètres de la maison et la description en texte libre sont transmis aux fournisseurs d'IA configurés pour la génération d'images et l'interprétation ; vos coordonnées personnelles ne le sont pas."

#: includes/Frontend/Help.php:41
msgid "Mi történik ajánlatkérés után?"
msgstr "Que se passe-t-il après la demande de devis ?"

#: includes/Frontend/Help.php:41
msgid "A kivitelező e-mailben értesítést kap egy biztonságos, időkorlátos hivatkozással a tervcsomaghoz, és felveszi veled a kapcsolatot."
msgstr "L'entrepreneur reçoit une notification par e-mail avec un lien sécurisé et à durée limitée vers le dossier du projet, puis prend contact avec vous."

#: includes/Frontend/Help.php:42
msgid "Kötelező a marketing-hozzájárulás?"
msgstr "Le consentement marketing est-il obligatoire ?"

#: includes/Frontend/Help.php:42
msgid "Nem. Az opcionális, és nem feltétele az ajánlatkérésnek."
msgstr "Non. Il est facultatif et ne conditionne pas la demande de devis."

