#: includes/Frontend/Strings.php
msgid "A pontos nyomvonal a gépészeti lépésben (1.14.1) rajzolható."
msgstr "Přesnou trasu nakreslíte v kroku TZB (1.14.1)."

#: includes/Frontend/Strings.php
msgid "Hogyan kezdjük?"
msgstr "Jak začneme?"

#: includes/Frontend/Strings.php
msgid "Építés az alapoktól"
msgstr "Stavba od základů"

#: includes/Frontend/Strings.php
msgid "Kőműves sorrendben: kitűzés, alap, falak, nyílások, födém, tető."
msgstr "V pořadí stavby: vytyčení, základy, zdi, otvory, strop, střecha."

#: includes/Frontend/Strings.php
msgid "Gyors terv"
msgstr "Rychlý návrh"

#: includes/Frontend/Strings.php
msgid "Stílus, méret, tető, homlokzat – pár lépésben kész a ház."
msgstr "Styl, velikost, střecha, fasáda – dům hotový v několika krocích."

#: includes/Frontend/Strings.php
msgid "A külső fal nem zárt: a falvégek nem érnek össze."
msgstr "Obvodová zeď není uzavřená: konce zdí se nestýkají."

#: includes/Frontend/Strings.php
msgid "Még nincs külső fal."
msgstr "Zatím není žádná obvodová zeď."

#: includes/Frontend/Strings.php
msgid "A nyílás nem létező szinten van."
msgstr "Otvor leží na neexistujícím podlaží."

#: includes/Frontend/Strings.php
msgid "A nyílás az áthidaló helyére, a födémbe ér."
msgstr "Otvor zasahuje do místa překladu a do stropu."

#: includes/Frontend/Strings.php
msgid "A nyílás egy falcsatlakozásra esik."
msgstr "Otvor padá na napojení zdí."

#: includes/Frontend/Strings.php
msgid "A nyílás fala már nincs meg."
msgstr "Zeď otvoru už neexistuje."

