#: includes/Frontend/Strings.php
msgid "A ház elkészült: a tető, a táj és a belső tér a megszokott módon állítható."
msgstr "Dům je hotový: střechu, okolí a interiér nastavíte jako obvykle."

#: includes/Frontend/Strings.php
msgid "Védőcsövek a lemez alatt"
msgstr "Chráničky pod deskou"

#: includes/Frontend/Strings.php
msgid "Alapföldelő"
msgstr "Základový zemnič"

#: includes/Frontend/Strings.php
msgid "Szennyvízcsatorna bekötése"
msgstr "Kanalizační přípojka"

#: includes/Frontend/Strings.php
