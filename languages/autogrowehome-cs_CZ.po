#: includes/Frontend/Strings.php
msgid "Előbb zárd körbe a házat a főfalakkal – a területmérleg a belső körvonalból számol."
msgstr "Nejprve uzavřete dům obvodovými zdmi – plošná bilance vychází z vnitřního obrysu."

#: includes/Frontend/Strings.php
msgid "Bruttó alapterület (külső méret)"
msgstr "Hrubá zastavěná plocha (vnější rozměr)"

#: includes/Frontend/Strings.php
msgid "Külső falak"
msgstr "Obvodové zdi"

#: includes/Frontend/Strings.php
msgid "Belső vakolat a külső falon (%s cm)"
msgstr "Vnitřní omítka na obvodové zdi (%s cm)"

#: includes/Frontend/Strings.php
msgid "Lépcső (becslés, még nincs megtervezve)"
msgstr "Schodiště (odhad, zatím nenavrženo)"

#: includes/Frontend/Strings.php
msgid "Megmaradó belső falak (vakolattal)"
msgstr "Zachované vnitřní zdi (s omítkou)"

#: includes/Frontend/Strings.php
msgid "Válaszfalak a helyiségek között (vakolattal)"
msgstr "Příčky mezi místnostmi (s omítkou)"

#: includes/Frontend/Strings.php
msgid "Válaszfalak (becslés, amíg nincs elhelyezve)"
msgstr "Příčky (odhad, dokud nejsou umístěny)"

#: includes/Frontend/Strings.php
msgid "Kiosztható nettó terület"
msgstr "Rozdělitelná čistá plocha"

#: includes/Frontend/Strings.php
msgid "A programban"
msgstr "V programu"

#: includes/Frontend/Strings.php
msgid "Még kiosztható"
msgstr "Ještě k rozdělení"

#: includes/Frontend/Strings.php
msgid "Túllépés: %s m² – a falakkal együtt nem fér el."
msgstr "Překročení: %s m² – se zdmi se nevejde."

#: includes/Frontend/Strings.php
msgid "Még egy helyiség (a saját falaival): legfeljebb kb. %s m²."
msgstr "Ještě jedna místnost (se svými zdmi): nejvýše asi %s m²."

#: includes/Frontend/Strings.php
msgid "Legnagyobb szabad hely a házban: %1$s × %2$s m."
msgstr "Největší volné místo v domě: %1$s × %2$s m."

#: includes/Frontend/Strings.php
msgid "A m² a kész, vakolt falsíkok között mért nettó terület. Az ajtónyílás a nettó területet nem változtatja."
msgstr "m² je čistá plocha měřená mezi hotovými omítnutými povrchy zdí. Dveřní otvor čistou plochu nemění."

#: includes/Frontend/Strings.php
msgid "Nincs közlekedő vagy előtér a programban – jellemzően a nettó %1$s százaléka (kb. %2$s m²)."
msgstr "V programu chybí chodba nebo předsíň – obvykle %1$s procent čisté plochy (asi %2$s m²)."

#: includes/Frontend/Strings.php
msgid "Elfér: %1$s × %2$s m"
msgstr "Vejde se: %1$s × %2$s m"

#: includes/Frontend/Strings.php
msgid "Nem fér el – kisebb terület vagy más méret kell"
msgstr "Nevejde se – je třeba menší plocha nebo jiný rozměr"

#: includes/Frontend/Strings.php
msgid "%1$s: legalább %2$s m² és %3$s m szélesség javasolt"
msgstr "%1$s: doporučeno alespoň %2$s m² a šířka %3$s m"

#: includes/Frontend/Strings.php
msgid "Kilóg a házból (a vakolattal együtt)."
msgstr "Přesahuje mimo dům (včetně omítky)."

#: includes/Frontend/Strings.php
msgid "Túl közel van egy másik helyiséghez – közte válaszfal és vakolat kell."
msgstr "Je příliš blízko jiné místnosti – mezi nimi musí být příčka a omítka."

#: includes/Frontend/Strings.php
msgid "Teherhordó falra került."
msgstr "Leží na nosné zdi."

#: includes/Frontend/Strings.php
msgid "A lépcsőre vagy a födémáttörésre került."
msgstr "Leží na schodišti nebo v otvoru stropu."

#: includes/Frontend/Strings.php
msgid "Elzárja a lépcső induló vagy érkező szabad helyét."
msgstr "Blokuje volný prostor u nástupu nebo výstupu schodiště."

#: includes/Frontend/Strings.php
msgid "Negyedfordulós (L)"
msgstr "Čtvrtotočené (L)"

#: includes/Frontend/Strings.php
msgid "Fordulós (U)"
msgstr "Dvouramenné (U)"

#: includes/Frontend/Strings.php
msgid "Karszélesség"
msgstr "Šířka ramene"

#: includes/Frontend/Strings.php
msgid "Elforgatás 90°"
msgstr "Otočit o 90°"

#: includes/Frontend/Strings.php
msgid "%1$s fok · fokmagasság %2$s cm · belépő %3$s cm · 2m + b = %4$s cm"
msgstr "%1$s stupňů · výška stupně %2$s cm · šířka stupně %3$s cm · 2h + b = %4$s cm"

#: includes/Frontend/Strings.php
msgid "Alaprajzi méret %1$s × %2$s m · födémáttörés %3$s m² · szabad belmagasság a lépcső felett ≥ %4$s m"
msgstr "Půdorys %1$s × %2$s m · otvor ve stropě %3$s m² · podchodná výška ≥ %4$s m"

#: includes/Frontend/Strings.php
msgid "A fokmagasság nagyobb a javasoltnál."
msgstr "Výška stupně je větší než doporučená."

#: includes/Frontend/Strings.php
msgid "A lépcsőképlet (2m + b) a 60–65 cm-es tartományon kívül esik."
msgstr "Vzorec schodiště (2h + b) je mimo rozsah 60–65 cm."

#: includes/Frontend/Strings.php
msgid "A belépő túl kicsi."
msgstr "Šířka stupně je příliš malá."

#: includes/Frontend/Strings.php
msgid "A karszélesség kisebb a javasolt legkisebbnél (0,9 m)."
msgstr "Šířka ramene je menší než doporučené minimum (0,9 m)."

#: includes/Frontend/Strings.php
msgid "Ekkora lépcső nem fér el – válassz fordulós vagy csigalépcsőt."
msgstr "Takové schodiště se nevejde – zvolte dvouramenné nebo točité."

#: includes/Frontend/Strings.php
msgid "A lépcső kilóg a házból."
msgstr "Schodiště přesahuje mimo dům."

#: includes/Frontend/Strings.php
msgid "A lépcső induló vagy érkező szabad helye nincs a házon belül."
msgstr "Volný prostor u nástupu nebo výstupu schodiště není uvnitř domu."

#: includes/Frontend/Strings.php
msgid "A lépcső vagy a födémáttörés teherhordó falra esik."
msgstr "Schodiště nebo otvor ve stropě zasahuje do nosné zdi."

#: includes/Frontend/Strings.php
msgid "Lépcső elhelyezése"
msgstr "Umístit schodiště"

#: includes/Frontend/Strings.php
msgid "A lépcső sehol nem fér el ebben a típusban – próbálj másik típust vagy keskenyebb kart."
msgstr "Schodiště tohoto typu se nikam nevejde – zkuste jiný typ nebo užší rameno."

#: includes/Frontend/Strings.php
msgid "Válaszd ki a lépcső típusát: a rendszer a szintmagasságból kiszámolja a fokokat, a méretét és a födémáttörést, és elhelyezi a házban."
msgstr "Vyberte typ schodiště: systém z výšky podlaží spočítá stupně, rozměry a otvor ve stropě a umístí ho do domu."

#: includes/Frontend/Strings.php
msgid "Födémáttörés"
msgstr "Otvor ve stropě"

#: includes/Frontend/Strings.php
msgid "A lépcső fokmagassága nagyobb a javasoltnál"
msgstr "Výška stupně schodiště je větší než doporučená"

#: includes/Frontend/Strings.php
msgid "A lépcsőképlet (2m + b) a 60–65 cm-es tartományon kívül"
msgstr "Vzorec schodiště (2h + b) mimo 60–65 cm"

#: includes/Frontend/Strings.php
msgid "A lépcső karszélessége keskenyebb a javasoltnál"
msgstr "Šířka ramene schodiště je menší než doporučená"

#: includes/Frontend/Strings.php
msgid "Az egyik oldala csak részben fekszik falon – told a fal végéig, vagy teljesen el a faltól."
msgstr "Jedna strana přiléhá ke zdi jen částečně – posuňte ji až ke konci zdi, nebo úplně od zdi."
