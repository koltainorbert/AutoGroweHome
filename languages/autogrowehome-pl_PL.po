#: includes/Frontend/Strings.php
msgid "Stílus, méret, tető, homlokzat – pár lépésben kész a ház."
msgstr "Styl, wymiary, dach, elewacja – dom gotowy w kilku krokach."

#: includes/Frontend/Strings.php
msgid "A külső fal nem zárt: a falvégek nem érnek össze."
msgstr "Ściana zewnętrzna nie jest zamknięta: końce ścian się nie stykają."

#: includes/Frontend/Strings.php
msgid "Még nincs külső fal."
