msgstr "Używane, gdy wybrany styl nie ma własnego zdjęcia wzorcowego."

#: includes/Admin/Admin.php
msgid "Belső tér mintakép"
msgstr "Zdjęcie wzorcowe wnętrza"

#: includes/Admin/Admin.php
