msgid "Prompt a 3D képből"
msgstr "Prompt from the 3D picture"

#: includes/Admin/Admin.php
msgid "Saját sablon"
msgstr "Own template"

#: includes/Admin/Admin.php
msgid "Üresen a beépített sablon megy. A „---” sor előtti rész a rendszerprompt, utána a feladat. Helyőrzők: {MAGNIFIC_DESCRIPTION}, {TIME_OF_DAY}, {SEASON}, {WEATHER}, {EXTRA_WISHES}; az üres érték helyére „default” kerül."
msgstr "Empty: the built-in template is used. The part before the “---” line is the system prompt, the part after it is the task. Placeholders: {MAGNIFIC_DESCRIPTION}, {TIME_OF_DAY}, {SEASON}, {WEATHER}, {EXTRA_WISHES}; an empty value is replaced by “default”."

